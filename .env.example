JWT_SECRET=change-me-to-a-long-random-string

# SMTP for email verification codes on sign-up.
# Leave SMTP_HOST empty to fall back to LogMailer (code printed to backend stdout).
# Yandex example:
#   SMTP_HOST=smtp.yandex.ru
#   SMTP_PORT=465
#   SMTP_USER=store@yandex.ru
#   SMTP_PASS=app-password
#   SMTP_FROM=ClothesStore <store@yandex.ru>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
